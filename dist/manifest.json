{
  "schemaVersion": 1,
  "name": "tizen-iptv-vn",
  "displayName": "IPTV Player DRM",
  "version": "1.0.2",
  "description": "IPTV player module for TizenBrew with Widevine DRM and MPEG-DASH support",
  "targetUrl": "https://localhost",
  "assets": {
    "scripts": [
      "index.js"
    ],
    "styles": []
  },
  "capabilities": {
    "tvKeys": {
      "arrows": true,
      "enter": true,
      "back": true,
      "playPause": true
    },
    "performance": {
      "removeAnimations": false,
      "lazyMedia": false,
      "hideComments": false,
      "memorySaver": false
    }
  }
}
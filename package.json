  "license": "MIT",
  "dependencies": {
    "shaka-player": "^4.11.7"
  },
  "devDependencies": {
    "@babel/cli": "^8.0.4",
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "core-js": "^3.50.0",
    "esbuild": "^0.25.0",
